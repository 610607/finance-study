# LaTeX build products (build.py and tools/check_chapter.py write here)
build/
*.aux
*.log
*.out
*.toc
*.cmp
*.cas
*.synctex.gz
# per-book entry files written (and removed) by build.py
macro/main_zh_book*.tex

# Python
__pycache__/
*.pyc

# Fonts extracted from the system Noto CJK collection for matplotlib (regenerated automatically)
**/figsrc/.fontcache/

# Raster and SVG copies of the figures are regenerated by figsrc/build.py; the PDFs are kept
**/figures/*.png
**/figures/*.svg
**/figures_zh/*.png
**/figures_zh/*.svg

# Data whose licence forbids redistribution: list the .csv here, keep its .json and fetch script
# macro/data/snapshots/<name>.csv
